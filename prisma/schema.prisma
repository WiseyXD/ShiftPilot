generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum StripePlan {
  TRIAL
  STARTER
  PRO
  NONE
}

enum ActionTokenAction {
  ACCEPT_SHIFT
  DECLINE_SHIFT
  SUBMIT_AVAILABILITY
  REPORT_SICK
  REQUEST_SWAP
  ACCEPT_SWAP
  DECLINE_SWAP
  APPROVE_SWAP
  REJECT_SWAP
  APPROVE_SCHEDULE
  ACCEPT_LOAN
  DECLINE_LOAN
  REQUEST_CHANGE
}

enum EmployeeCategory {
  MINIJOB_ZEITARBEIT // availability-bound; can accept/decline
  TEILZEIT_FEST // freely assignable; cannot decline, only request a change
}

enum ScheduleStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

enum ShiftStatus {
  PENDING
  ACCEPTED
  DECLINED
  REASSIGNED
  UNASSIGNED
  LENT_OUT // worker is lent to another venue — ALWAYS suppresses the backfill engine
}

enum SharingListingType {
  OFFER
  REQUEST
}

enum SharingListingStatus {
  OPEN
  CANCELLED
  MATCHED
}

enum SharingDealStatus {
  AWAITING_MANAGER // waiting for the listing owner's manager to confirm
  MANAGERS_AGREED // both managers in; worker consent comes next
  DECLINED // a manager said no (terminal)
  FILLED // worker accepted — loan is on
  WORKER_DECLINED // worker said no (terminal); listing reopens
  EXPIRED // worker never answered (terminal); listing reopens
}

enum SwapRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

// ─── Owner / Auth ─────────────────────────────────────────────────────────────

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePlan           StripePlan @default(TRIAL)
  trialEndsAt          DateTime
  createdAt            DateTime   @default(now())

  locations    Location[]
  actionTokens ActionToken[]
}

// ─── Location (replaces Cafe) ─────────────────────────────────────────────────

model Location {
  id                     String   @id @default(cuid())
  ownerId                String
  name                   String
  timezone               String   @default("UTC")
  generationDayOfWeek    Int      @default(3) // 0=Sun 1=Mon ... 6=Sat; default Wednesday
  freezeWindowHours      Int      @default(24)
  escalationTimeoutHours Int      @default(2)
  // Marketplace discovery — venues are invisible to other owners unless they opt in
  address                String?
  lat                    Float?
  lng                    Float?
  isDiscoverable         Boolean  @default(false)
  discoveryRadiusKm      Int      @default(3)
  createdAt              DateTime @default(now())

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  employees       Employee[]
  shiftTemplates  ShiftTemplate[]
  schedules       Schedule[]
  auditLogs       AuditLog[]
  sharingListings SharingListing[]
  lenderDeals     SharingDeal[]    @relation("LenderDeals")
  borrowerDeals   SharingDeal[]    @relation("BorrowerDeals")
  fixedShifts     FixedShift[]
  blockedTimes    BlockedTime[]
  vacations       Vacation[]

  @@index([ownerId])
}

// ─── Employees ────────────────────────────────────────────────────────────────

model Employee {
  id              String           @id @default(cuid())
  locationId      String
  name            String
  email           String
  roles           String[]
  minHours        Int              @default(0)
  maxHours        Int              @default(40)
  category        EmployeeCategory @default(MINIJOB_ZEITARBEIT)
  birthDate       DateTime? // needed for JArbSchG minor rules
  phone           String? // digits only, for the WhatsApp channel
  hourlyWageCents Int? // needed for the Minijob earnings cap
  isWerkstudent   Boolean          @default(false)
  lectureFree     Boolean          @default(false) // Werkstudent: lecture-free period lifts the 20h cap
  createdAt       DateTime         @default(now())

  location              Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recurringAvailability RecurringAvailability[]
  availabilityOverrides AvailabilityOverride[]
  actionTokens          ActionToken[]
  shifts                Shift[]
  swapRequestsInitiated SwapRequest[]          @relation("SwapRequester")
  swapRequestsProposed  SwapRequest[]          @relation("SwapProposed")
  sharingListings       SharingListing[]
  sharingDeals          SharingDeal[]
  fixedShifts           FixedShift[]
  blockedTimes          BlockedTime[]
  vacations             Vacation[]

  @@unique([locationId, email])
  @@index([locationId])
}

// ─── Shift Templates ──────────────────────────────────────────────────────────

model ShiftTemplate {
  id            String   @id @default(cuid())
  locationId    String
  name          String
  startTime     String   // "09:00"
  endTime       String   // "17:00"
  minHeadcount  Int      @default(1)
  requiredRoles String[]
  createdAt     DateTime @default(now())

  location              Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recurringAvailability RecurringAvailability[]
  availabilityOverrides AvailabilityOverride[]
  shifts                Shift[]
  fixedShifts           FixedShift[]
  blockedTimes          BlockedTime[]

  @@index([locationId])
}

// ─── Availability ─────────────────────────────────────────────────────────────

model RecurringAvailability {
  id              String @id @default(cuid())
  employeeId      String
  shiftTemplateId String
  dayOfWeek       Int    // 0=Sun 1=Mon ... 6=Sat

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, shiftTemplateId, dayOfWeek])
  @@index([employeeId])
}

model AvailabilityOverride {
  id              String   @id @default(cuid())
  employeeId      String
  shiftTemplateId String
  date            DateTime
  available       Boolean

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, shiftTemplateId, date])
  @@index([employeeId])
}

// ─── Schedules & Shifts ───────────────────────────────────────────────────────

model Schedule {
  id          String         @id @default(cuid())
  locationId  String
  weekStart   DateTime
  status      ScheduleStatus @default(DRAFT)
  generatedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shifts   Shift[]

  @@index([locationId])
}

model Shift {
  id              String      @id @default(cuid())
  scheduleId      String
  shiftTemplateId String
  employeeId      String?
  dayOfWeek       Int         @default(0) // 0=Sun 1=Mon ... 6=Sat
  status          ShiftStatus @default(PENDING)
  sharingDealId   String? // set on the borrower's shift (and the lender's LENT_OUT shift) when a deal fills

  schedule      Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sharingDeal   SharingDeal?  @relation(fields: [sharingDealId], references: [id], onDelete: SetNull)
  swapRequests  SwapRequest[]

  @@index([scheduleId])
  @@index([employeeId])
}

// ─── Swap Requests ────────────────────────────────────────────────────────────

model SwapRequest {
  id                 String            @id @default(cuid())
  shiftId            String
  requesterId        String
  proposedEmployeeId String?
  status             SwapRequestStatus @default(PENDING)
  createdAt          DateTime          @default(now())

  shift            Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester        Employee  @relation("SwapRequester", fields: [requesterId], references: [id])
  proposedEmployee Employee? @relation("SwapProposed", fields: [proposedEmployeeId], references: [id])

  @@index([shiftId])
  @@index([requesterId])
}

// ─── Staff-Sharing Marketplace ────────────────────────────────────────────────

model SharingListing {
  id              String               @id @default(cuid())
  locationId      String
  type            SharingListingType
  role            String
  date            DateTime
  startTime       String // "17:00"
  endTime         String // "22:00"
  employeeId      String? // the lender's employee — required for OFFER listings
  hourlyRateCents Int? // null = negotiable
  status          SharingListingStatus @default(OPEN)
  createdAt       DateTime             @default(now())

  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deals    SharingDeal[]

  @@index([locationId])
  @@index([status])
}

model SharingDeal {
  id                 String            @id @default(cuid())
  listingId          String
  lenderLocationId   String
  borrowerLocationId String
  employeeId         String // always the LENDER's employee — never a cross-tenant reference
  agreedRateCents    Int? // null = negotiable, settled offline
  status             SharingDealStatus @default(AWAITING_MANAGER)
  createdAt          DateTime          @default(now())

  listing          SharingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lenderLocation   Location       @relation("LenderDeals", fields: [lenderLocationId], references: [id], onDelete: Cascade)
  borrowerLocation Location       @relation("BorrowerDeals", fields: [borrowerLocationId], references: [id], onDelete: Cascade)
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shifts           Shift[]

  @@index([listingId])
  @@index([lenderLocationId])
  @@index([borrowerLocationId])
}

// ─── Action Tokens ────────────────────────────────────────────────────────────

model ActionToken {
  id         String            @id @default(cuid())
  employeeId String?
  userId     String?
  action     ActionTokenAction
  payload    Json
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([userId])
  @@index([expiresAt])
}

// ─── Vacations ────────────────────────────────────────────────────────────────

// An absence period: the employee is excluded from generation, outreach, and
// marketplace loans for every date in [startDate, endDate] (inclusive).
model Vacation {
  id         String   @id @default(cuid())
  locationId String
  employeeId String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([employeeId])
}

// ─── Manager rule engine: pins + Sperrzeiten ──────────────────────────────────

// A pinned assignment: this employee works this template on this weekday —
// permanently (weekStart null) or for one specific week. Priority 2: only
// legal limits can override a pin.
model FixedShift {
  id              String    @id @default(cuid())
  locationId      String
  employeeId      String
  shiftTemplateId String
  dayOfWeek       Int // 0=Sun 1=Mon ... 6=Sat
  weekStart       DateTime? // null = every week
  createdAt       DateTime  @default(now())

  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

// A Sperrzeit: never schedule this employee for this weekday (optionally only
// for one template). Hard exclusion in generation AND outreach.
model BlockedTime {
  id              String   @id @default(cuid())
  locationId      String
  employeeId      String
  shiftTemplateId String? // null = the whole day
  dayOfWeek       Int
  createdAt       DateTime @default(now())

  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([employeeId])
}

// ─── Compliance ───────────────────────────────────────────────────────────────

// Effective-dated legal rule values (ArbZG etc.). Values change over time
// (minimum-wage coupling, legal amendments) — never hardcode them in logic.
model ComplianceRuleSet {
  id            String   @id @default(cuid())
  effectiveFrom DateTime
  rules         Json // shape: ArbZGRules in lib/compliance/rules.ts
  note          String? // e.g. "2026 statutory values"
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id                   String   @id @default(cuid())
  locationId           String
  action               String
  aiReasoning          String
  candidatesConsidered Json
  outcome              String
  createdAt            DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([createdAt])
}
